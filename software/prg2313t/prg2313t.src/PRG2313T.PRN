  04A3'   11 0003'              Start:	ld	de,header	;заголовок программы
  04A6'   0E 09                 	ld	c,9		;print message
  04A8'   CD 0005               	call	bdos
                                ;
                                ;==================================================
                                ; проверить подключение контроллера
  04AB'   CD 0000*              	call	set_j1		;Задать Джойстик 1
                                ; прочитать сигнатуру МК
  04AE'   CD 0000*              	call	set_prg		;Задать режим программирования МК
  04B1'   28 22                 	jr	z,ini_ok	;подключен к порту 1
                                ; проверить второй порт
  04B3'   CD 0000*              	call	res_joy		;вернуть назад
Macro Assembler-80 v2.22D   (c) 1995,1996,1997 MOA  Page 1-7


  04B6'   3E 32                 	ld	a,'2'
  04B8'   32 01F0'              	ld	(port_n),a	;номер порта джойстика
  04BB'   CD 0000*              	call	set_j2		;Задать Джойстик 2
  04BE'   CD 0000*              	call	set_prg		;Задать режим программирования МК
  04C1'   28 12                 	jr	z,ini_ok	;подключен к порту 2
  04C3'   FB                    	ei
                                ; Не обнаружено подключение МК к MSX
  04C4'   11 0047'              e_set:	ld	de,t_ncnct	;'CHIP not connect to MSX:'
  04C7'   18 03                 	jr	e_exit
  04C9'   11 0213'              e_sign:	ld	de,t_esign	;' -> Not a known type'
  04CC'   0E 09                 e_exit:	ld	c,9
  04CE'   CD 0005               	call	bdos
  04D1'   CD 0000*              	call	res_joy
  04D4'   C7                    	rst	0
                                ;====================================
                                ; МК подключен к одному из портов джойстика
  04D5'   FB                    ini_ok:	ei
                                ; Напечатать имя порта, куда подключен МК
  04D6'   11 01DA'                      ld	de,t_cnct	;'Connect to port 1|2'
  04D9'   0E 09                 	ld	c,9
  04DB'   CD 0005               	call	bdos
                                ; Прочитать сигнатуру
  04DE'   CD 0000*              	call	set_prg
  04E1'   20 E1                 	jr	nz,e_set
  04E3'   CD 0000*              	call	rd_sgn		;прочитать сигнатуру МК
                                ;   D,  E,  C = 3 байта сигнатуры
                                ; 0Ah,91h,1Eh -> ATTiny2313
  04E6'   FB                    	ei
  04E7'   D5                    	push	de
  04E8'   C5                    	push	bc
  04E9'   CD 072D'              	call	prn_dec		; напечатать сигнатуру
  04EC'   C1                    	pop	bc
  04ED'   D1                    	pop	de
                                ; сравнить сигнатуру с шаблоном
  04EE'   7A                    	ld	a,d
  04EF'   FE 0A                 	cp	0ah
  04F1'   20 D6                 	jr	nz,e_sign	;Ошибка типа МК
  04F3'   7B                    	ld	a,e
  04F4'   FE 91                 	cp	91h
  04F6'   20 D1                 	jr	nz,e_sign       ;
  04F8'   79                    	ld	a,c
  04F9'   FE 1E                 	cp	1eh
  04FB'   20 CC                 	jr	nz,e_sign	;
                                ; Сигнатура совпала
  04FD'   11 01FC'              	ld	de,t_t2313	;' -> ATTiny2313'
  0500'   0E 09                 	ld	c,9
  0502'   CD 0005               	call	bdos 	
                                ;------
                                ; прочитать FUSES
  0505'   3E 01                 	ld	a,1
  0507'   32 0566'              rd_fus:	ld	(c_fus),a	;счетчик записи FUSES
  050A'   11 0226'              	ld	de,t_fuse	;'FUSES: '
  050D'   0E 09                 	ld	c,9
  050F'   CD 0005               	call	bdos
                                ;
  0512'   CD 0000*              	call	set_prg
Macro Assembler-80 v2.22D   (c) 1995,1996,1997 MOA  Page 1-8


  0515'   20 AD                 	jr	nz,e_set
  0517'   CD 0000*              	call	rd_fuse		;прочитать FUSES
                                ;   D,  E,  C = 3 байта FUSES  (E4 DF FF)
  051A'   FB                    	ei
  051B'   CD 072D'              	call	prn_dec		;напечатать FUSES
