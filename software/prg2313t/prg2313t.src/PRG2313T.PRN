                                ;--------------------------------------------
                                ; LOW BYTE             DEF     SET
                                ;--------------------------------------------
                                ; 7 - CLKDIV8           0       1
                                ; 6 - CKOUT             1       1
                                ; 5 - SUT1              1       1
                                ; 4 - SUT0              0       0
                                ; 3 - CKSEL3   		0       0
                                ; 2 - CKSEL2            1       1
                                ; 1 - CKSEL1            0       0
                                ; 0 - CKSEL0            0       0
                                ;--------------------------------------------
  051F'   7A                    	ld	a,d		;FUSE LOW
