                                ;CLKDIV8=1 -> CLK=CLK
  0483'   03D1'                 tab_clk:dw	t_clkex	;0 ' -> Ext. Clock'
  0485'   046E'                 	dw	t_clkre	;1 ' -> Reserved FUSES'
  0487'   0412'                 	dw	t_clk_4	;2 ' -> Int. Clk = 4 MHz'
  0489'   046E'                 	dw	t_clkre	;3 ' -> Reserved FUSES'
