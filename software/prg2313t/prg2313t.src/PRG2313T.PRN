  048F'   0440'                 	dw	t_clkwo	;6 ' -> Wdog Clk = 128 kHz'
  0491'   046E'                 	dw	t_clkre	;7 ' -> Reserved FUSES'
                                ;CLKDIV8=0 -> CLK=CLK/8
  0493'   03D1'                 tab_cl8:dw	t_clkex	;0 ' -> Ext. Clock'
  0495'   046E'                 	dw	t_clkre	;1 ' -> Reserved FUSES'
  0497'   03E2'                 	dw	t_clk05	;2 ' -> Int. Clk = 0.5 MHz'
  0499'   046E'                 	dw	t_clkre	;3 ' -> Reserved FUSES'
  049B'   03FB'                 	dw	t_clk_1	;4 ' -> Int. Clk = 1 MHz'
  049D'   046E'                 	dw	t_clkre	;5 ' -> Reserved FUSES'
  049F'   0440'                 	dw	t_clkwo	;6 ' -> Wdog Clk = 128 kHz'
  04A1'   046E'                 	dw	t_clkre	;7 ' -> Reserved FUSES'
